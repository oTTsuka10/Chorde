PORT=3000
PYTHON_BIN=python

# Desenvolvimento local funciona sem nada abaixo (SQLite + disco local).
# Em producao (Render), preencha para ter persistencia real.

# Supabase -> Database -> Connection string (Transaction pooler, porta 6543), com ?sslmode=require
DATABASE_URL=

# Supabase -> Project Settings -> API: URL do projeto
SUPABASE_URL=
# Supabase -> Project Settings -> API -> service_role (SEGREDO — so em variavel de ambiente)
SUPABASE_SERVICE_KEY=
# Nome do bucket criado no Supabase Storage (padrao: audio)
SUPABASE_BUCKET=audio

# Modelo do Whisper (tiny = leve, bom para planos gratuitos; base/tiny/small...)
WHISPER_MODEL=tiny

# So usado no fallback local (sem Supabase)
STORAGE_DIR=./storage
